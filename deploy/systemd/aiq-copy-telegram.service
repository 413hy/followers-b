[Unit]
Description=AI Quant copy-trading Telegram bot
After=network-online.target aiq-copy-migrations.service
Wants=network-online.target
Requires=aiq-copy-migrations.service
OnFailure=aiq-copy-incident-reporter@%n.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/quantify/ai-quant-system
UMask=0077
ExecStart=/root/quantify/ai-quant-system/.venv/bin/python -m ai_quant.services.copy_telegram_bot --environment TESTNET --database-url-file /run/ai-quant-secrets/copy-business-database-url --token-file /run/ai-quant-secrets/copy-telegram-bot-token --chat-ids-file /run/ai-quant-secrets/copy-telegram-chat-ids --authorized-user-ids-file /run/ai-quant-secrets/copy-telegram-authorized-user-ids --repository-root /root/quantify/ai-quant-system
ExecStopPost=/root/quantify/ai-quant-system/.venv/bin/python -m ai_quant.services.copy_failure_hook --source-unit aiq-copy-telegram.service
Restart=on-failure
RestartSec=30
TimeoutStopSec=40
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
InaccessiblePaths=/root/aiq-user-inputs /run/ai-quant-secrets/binance-testnet-api-key /run/ai-quant-secrets/binance-testnet-api-secret

[Install]
WantedBy=multi-user.target
