[Unit]
Description=Materialize AI Quant copy-trading secrets in volatile storage
After=local-fs.target
Before=aiq-copy-infra.service aiq-copy-telegram.service aiq-copy-poller.service
RequiresMountsFor=/root/aiq-user-inputs/copy-trading/secrets /root/aiq-user-inputs/notifications

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=ai-quant-secrets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
WorkingDirectory=/root/quantify/ai-quant-system
ExecStart=/root/quantify/ai-quant-system/.venv/bin/python -m ai_quant.services.copy_secrets --environment TESTNET --repository-root /root/quantify/ai-quant-system --runtime-directory /run/ai-quant-secrets --database-password-file /root/aiq-user-inputs/copy-trading/secrets/business_db_password --testnet-arm-file /root/aiq-user-inputs/copy-trading/secrets/testnet_copy_trading_arm --telegram-token-file /root/aiq-user-inputs/notifications/secrets/telegram_bot_token --telegram-chat-ids-file /root/aiq-user-inputs/notifications/telegram_chat_ids --telegram-authorized-user-ids-file /root/aiq-user-inputs/notifications/telegram_authorized_user_ids
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/root/aiq-user-inputs/copy-trading/secrets /root/aiq-user-inputs/notifications
ReadWritePaths=/run/ai-quant-secrets

[Install]
WantedBy=multi-user.target
