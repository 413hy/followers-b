[Unit]
Description=Materialize AI Quant production exchange credentials in volatile storage
After=local-fs.target
Before=aiq-copy-poller.service aiq-copy-watchdog.service
RequiresMountsFor=/root/aiq-user-inputs/copy-trading/production

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=ai-quant-production-secrets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/install -m 0400 -o root -g root /root/aiq-user-inputs/copy-trading/production/binance_api_key /run/ai-quant-production-secrets/binance-production-api-key
ExecStart=/usr/bin/install -m 0400 -o root -g root /root/aiq-user-inputs/copy-trading/production/binance_api_secret /run/ai-quant-production-secrets/binance-production-api-secret
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/root/aiq-user-inputs/copy-trading/production
ReadWritePaths=/run/ai-quant-production-secrets

[Install]
WantedBy=multi-user.target
