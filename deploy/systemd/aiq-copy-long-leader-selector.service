[Unit]
Description=AI Quant weekly Codex-assisted long-term leader selection
After=network-online.target aiq-copy-migrations.service
Wants=network-online.target
Requires=aiq-copy-migrations.service
OnFailure=aiq-copy-incident-reporter@%n.service
# This oneshot is invoked by the weekly timer, incident recovery and explicit operator
# reviews. Successful reviews must not exhaust an hour-wide failure budget.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/quantify/ai-quant-system
UMask=0077
ExecStart=/usr/bin/flock --exclusive --wait 1200 /run/ai-quant-copy-selection.lock /root/quantify/ai-quant-system/.venv/bin/python -m ai_quant.services.copy_leader_selector --environment TESTNET --database-url-file /run/ai-quant-secrets/copy-business-database-url --repository-root /root/quantify/ai-quant-system --config-file config/copy-trading.example.yaml --schema-file contracts/copy-leader-selection.schema.json --work-root /var/lib/ai-quant/codex/copy-selection/long --evidence-file /var/lib/ai-quant/evidence/copy-trading/selection/long/latest.json --leader-count 1 --candidate-pool-size 100 --review-pool-size 20 --strategy LONG_TERM
TimeoutStartSec=2400
Restart=on-failure
RestartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/root/.codex /var/lib/ai-quant/codex /var/lib/ai-quant/evidence/copy-trading
InaccessiblePaths=/root/aiq-user-inputs -/run/ai-quant-production-secrets /run/ai-quant-secrets/binance-testnet-api-key /run/ai-quant-secrets/binance-testnet-api-secret /run/ai-quant-secrets/copy-telegram-bot-token /run/ai-quant-secrets/copy-telegram-chat-ids /run/ai-quant-secrets/copy-telegram-authorized-user-ids

[Install]
WantedBy=multi-user.target
