[Unit]
Description=AI Quant replay pending out-of-band copy-system incidents
After=network-online.target aiq-copy-secrets.service
Wants=network-online.target aiq-copy-secrets.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/quantify/ai-quant-system
UMask=0077
StateDirectory=ai-quant
StateDirectoryMode=0700
ExecStart=/root/quantify/ai-quant-system/.venv/bin/python -m ai_quant.services.copy_incident_reporter --replay-pending --token-file /run/ai-quant-secrets/copy-telegram-bot-token --chat-ids-file /run/ai-quant-secrets/copy-telegram-chat-ids --authorized-user-ids-file /run/ai-quant-secrets/copy-telegram-authorized-user-ids --evidence-root /var/lib/ai-quant/evidence/copy-trading/incidents
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/ai-quant
InaccessiblePaths=/root/aiq-user-inputs /run/ai-quant-secrets/binance-testnet-api-key /run/ai-quant-secrets/binance-testnet-api-secret
