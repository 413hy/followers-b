{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "recommended_actions"],
  "properties": {
    "status": {"type": "string", "enum": ["HEALTHY", "DEGRADED", "CRITICAL"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "evidence", "recommended_action"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]{3,80}$"},
          "severity": {"type": "string", "enum": ["INFO", "WARNING", "CRITICAL"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 400},
          "recommended_action": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "NO_ACTION",
          "PAUSE_NEW_ENTRIES",
          "RESTART_COPY_POLLER",
          "RESTART_TELEGRAM",
          "RUN_CODE_REPAIR"
        ]
      }
    }
  }
}
